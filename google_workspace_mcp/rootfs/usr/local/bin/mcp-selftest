#!/bin/bash
# Gemeinsamer Selbsttest aller Add-ons dieses Repos.
# Quelle: common/mcp-selftest. Die Kopien in <add-on>/rootfs/usr/local/bin/ müssen
# identisch sein, das prüft der Build (.github/scripts/sync_common.py).
#
# Startet jeden Dienst aus services.sh mit genau dem Befehl, den das Add-on nutzt,
# und prüft, ob er auf MCP "initialize" und "tools/list" antwortet. Läuft im Build
# nach jedem Versionswechsel. Rückgabewert 0 = alles in Ordnung.
set -uo pipefail

log()    { echo "$*"; }
fehler() { echo "FEHLER $*" >&2; exit 1; }

SELFTEST_DIR="$(mktemp -d)"
trap 'rm -rf "$SELFTEST_DIR"' EXIT
export HOME="$SELFTEST_DIR"

# shellcheck source=/dev/null
source /usr/local/lib/mcp/services.sh
selftest_setup
rc=0

echo "Architektur: $(uname -m)"
cat /usr/local/share/mcp-versions

if mcp-auth-proxy --help >/dev/null 2>&1; then
  echo "ok    mcp-auth-proxy startet"
else
  echo "FEHLER mcp-auth-proxy startet nicht"; rc=1
fi

init='{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"mcp-selftest","version":"1"}}}'
bereit='{"jsonrpc":"2.0","method":"notifications/initialized"}'
liste='{"jsonrpc":"2.0","id":2,"method":"tools/list"}'

for svc in "${SERVICES[@]}"; do
  service_cmd "$svc"
  out="$({ printf '%s\n' "$init" "$bereit" "$liste"; sleep "${SELFTEST_WAIT:-10}"; } \
    | timeout 180 "${CMD[@]}" 2>"$SELFTEST_DIR/$svc.err")"
  tools="$(jq -R 'fromjson? | select(.id == 2) | .result.tools | length' <<<"$out" | head -n1)"
  if [[ "$tools" =~ ^[0-9]+$ ]] && (( tools > 0 )); then
    echo "ok    $svc: $tools Tools (${CMD[*]})"
  else
    echo "FEHLER $svc antwortet nicht wie erwartet (${CMD[*]})"
    sed 's/^/      /' "$SELFTEST_DIR/$svc.err" | tail -n 20
    rc=1
  fi
done

# Brücke für den internen Zugriff (internal_access): mit dem ersten Dienst über HTTP prüfen.
svc="${SERVICES[0]}"
service_cmd "$svc"
# shellcheck disable=SC2004  # $svc ist der Schlüssel eines assoziativen Arrays
bport=$(( 19000 + PORTS[$svc] % 1000 ))
BRIDGE_TOKEN=selftest-token python3 /usr/local/lib/mcp/mcp_bridge.py "$bport" -- "${CMD[@]}" 2>"$SELFTEST_DIR/bridge.err" &
bpid=$!
if python3 - "$bport" "$svc" <<'PY'
import json, sys, time, urllib.error, urllib.request
url = f"http://127.0.0.1:{sys.argv[1]}/mcp"
H = {"Content-Type": "application/json", "Accept": "application/json, text/event-stream",
     "Authorization": "Bearer selftest-token"}

def post(msg, extra=None):
    req = urllib.request.Request(url, json.dumps(msg).encode(), {**H, **(extra or {})})
    with urllib.request.urlopen(req, timeout=180) as r:
        return r.status, r.read()

def code(fn):
    try:
        return fn()[0]
    except urllib.error.HTTPError as e:
        return e.code

for _ in range(50):
    try:
        urllib.request.urlopen(f"http://127.0.0.1:{sys.argv[1]}/health", timeout=2); break
    except OSError:
        time.sleep(0.2)
init = {"jsonrpc": "2.0", "id": "a", "method": "initialize", "params": {
    "protocolVersion": "2025-06-18", "capabilities": {}, "clientInfo": {"name": "t", "version": "1"}}}
s, b = post(init); assert s == 200 and json.loads(b)["id"] == "a", b
s, _ = post({"jsonrpc": "2.0", "method": "notifications/initialized"}); assert s == 202, s
s, b = post({"jsonrpc": "2.0", "id": 7, "method": "tools/list"})
r = json.loads(b); assert r["id"] == 7 and len(r["result"]["tools"]) > 0, b
s, b = post({**init, "id": 2}); assert json.loads(b)["id"] == 2, b          # zweiter Client
assert code(lambda: post(init, {"Origin": "http://evil"})) == 403
assert code(lambda: post(init, {"Authorization": ""})) == 401
assert code(lambda: post(init, {"Authorization": "Bearer falsch"})) == 401
assert code(lambda: urllib.request.urlopen(url, timeout=5)) == 401                  # GET ohne Token
assert code(lambda: urllib.request.urlopen(urllib.request.Request(url, headers={"Authorization": H["Authorization"]}), timeout=5)) == 405
print(f"ok    Brücke ({sys.argv[2]}): {len(r['result']['tools'])} Tools über HTTP, Origin-Schutz und Token aktiv")
PY
then :; else
  echo "FEHLER Brücke antwortet nicht wie erwartet"
  sed 's/^/      /' "$SELFTEST_DIR/bridge.err" | tail -n 20
  rc=1
fi
kill "$bpid" 2>/dev/null; wait "$bpid" 2>/dev/null

# Zusätzliche Prüfungen eines Add-ons, falls services.sh sie definiert.
if declare -F selftest_extra >/dev/null; then
  selftest_extra || rc=1
fi

exit $rc
