#!/usr/bin/env bash
# Mehrbenutzer-Modus der App Open Terminal (läuft als root, von run.sh gestartet).
#   terminal-konten start    Konten aus /data/homes/.konten mit festen UIDs anlegen, Rechte setzen
#   terminal-konten waechter neue Konten von Open Terminal erfassen und einrichten (Schleife)
#   terminal-konten aufraeumen  ACL-Einträge aller bekannten Konten entfernen (Modus aus)
#   terminal-konten webdav   WebDAV-Zugang (Option webdav) als rclone-Ziel nur für Administratoren
#
# Open Terminal legt je X-User-Id ein Linux-Konto an (erste 8 Zeichen der ID, vorne "u" bei
# Ziffer). UID und GID vergibt useradd fortlaufend; damit ACLs nach einem Neustart nicht beim
# Falschen landen, merkt sich dieses Skript Name und UID und legt die Konten beim Start
# mit derselben UID wieder an. UIDs ab 20000 (login.defs), damit sie nicht mit Besitzern
# von Dateien unter /share zusammenfallen (Besitzerrechte gingen vor der ACL-Sperre). Administratoren (Option admin_users) bekommen das bisherige
# Home (/data/home) und die Rechte von "user"; alle anderen ein eigenes Home unter
# /data/homes/<konto> und von /share nur den eigenen Arbeitsbereich <Familienordner>/<konto>
# (dokumente, inbox, work; auch als ~/dokumente usw.) und <Familienordner>/gemeinsam.
# Speicher je Konto (Home + Arbeitsbereich) begrenzt die Option quota_gb (weich, etwa minütlich).
set -uo pipefail
DATA=${ADDON_DATA_DIR:-/data}
OPTS="$DATA/options.json"
HOMES="$DATA/homes"
KARTE="$HOMES/.konten"
ZIELE="$DATA/.acl_ziele"          # von run.sh: Ordner mit Schreibrecht für user (je Zeile)
SHARE=${TERMINAL_SHARE:-/share}
log() { echo "[konten] $*"; }

kontoname() { # wie open_terminal.utils.user_isolation.sanitize_username (ohne Präfix)
  python3 - "$1" <<'PY'
import hashlib, re, sys
u = sys.argv[1]
c = re.sub(r"[^a-z0-9]", "", u.lower())
n = c[:8] if len(c) >= 4 else hashlib.sha256(u.encode()).hexdigest()[:8]
print(("u" + n) if n[0].isdigit() else n)
PY
}

ADMINS=" "
while IFS= read -r id; do
  [ -n "$id" ] && ADMINS+="$(kontoname "$id") "
done < <(jq -r '.admin_users // [] | .[]' "$OPTS" 2>/dev/null)
FAMILIE=$(jq -r '.family_dir // ""' "$OPTS" 2>/dev/null)
FAM=${FAMILIE:+$SHARE/$FAMILIE}
# Speicher je Konto (Home + Arbeitsbereich) in GB, 0 = unbegrenzt
QUOTA_GB=$(jq -r '.quota_gb // 10' "$OPTS" 2>/dev/null); [[ "$QUOTA_GB" =~ ^[0-9]+$ ]] || QUOTA_GB=10
VOLL=.speicher-voll
ist_admin() { [[ "$ADMINS" == *" $1 "* ]]; }

home_von() { if ist_admin "$1"; then echo "$DATA/home"; else echo "$HOMES/$1"; fi; }

rechte() { # $1 Konto
  local k=$1 h e
  h=$(home_von "$k")
  usermod -aG "$k" user 2>/dev/null || true   # Open Terminal liest Dateien als "user"
  # Python-/R-Pakete aus dem Home von user (~/.venv, ~/R) für alle lesbar, sonst nichts davon
  setfacl -m "u:$k:--x" "$DATA" "$DATA/home" 2>/dev/null
  for e in "$DATA/home/.venv" "$DATA/home/R"; do
    [ -e "$e" ] && setfacl -R -m "u:$k:rX" -m "d:u:$k:rX" "$e" 2>/dev/null
  done
  setfacl -m "u:$k:---" "$OPTS" "$DATA/api_key" 2>/dev/null
  if ist_admin "$k"; then
    setfacl -R -m "u:$k:rwX" -m "d:u:$k:rwX" "$DATA/home" 2>/dev/null
    while IFS= read -r z; do
      [ -n "$z" ] && [ -e "$z" ] && setfacl -R -m "u:$k:rwX" -m "d:u:$k:rwX" "$z" 2>/dev/null
    done < <(cat "$ZIELE" 2>/dev/null)
    log "$k: Administrator (Home $h, Zugriff auf $SHARE wie bisher)"
    # Administratoren sehen den ganzen Familienordner, auch alle Arbeitsbereiche
    [ -n "$FAM" ] && setfacl -R -m "u:$k:rwX" -m "d:u:$k:rwX" "$FAM" 2>/dev/null
  else
    mkdir -p "$h"; chown "$k:$k" "$h"; chmod 2770 "$h"
    setfacl -m "u:$k:--x" "$SHARE" 2>/dev/null
    sperren "$k"
    if [ -n "$FAM" ]; then
      # Familienordner selbst nur durchqueren; keine Vorgabe-Rechte dort, sonst erbten neue
      # Arbeitsbereiche die Rechte aller Konten
      setfacl -m "u:$k:--x" "$FAM" 2>/dev/null
      setfacl -x "d:u:$k" "$FAM" 2>/dev/null
      setfacl -R -m "u:$k:rwX" -m "d:u:$k:rwX" "$FAM/gemeinsam" 2>/dev/null
      arbeitsbereich "$k"
      verlinken "$k" "$h"
    fi
    [ -e "$h/vorlagen" ] || [ -L "$h/vorlagen" ] || { ln -s /usr/local/share/vorlagen "$h/vorlagen"; chown -h "$k:$k" "$h/vorlagen"; }
    if [ -n "$FAM" ]; then
      log "$k: eigenes Home $h, von $SHARE nur $FAMILIE/$k und $FAMILIE/gemeinsam"
    else
      log "$k: eigenes Home $h, von $SHARE nichts"
    fi
  fi
}

familie_vorbereiten() { # einmal beim Start: gemeinsam/, alte Struktur übernehmen
  [ -n "$FAM" ] || return 0
  mkdir -p "$FAM/gemeinsam"
  # "user" (Datei-Werkzeuge von Open Terminal) und Open WebUI (root) legen dort ab
  setfacl -m u:user:r-x "$FAM" 2>/dev/null
  setfacl -R -m u:user:rwX -m d:u:user:rwX "$FAM/gemeinsam" 2>/dev/null
  [ -e "$FAM/.struktur" ] && return 0
  # Bis 0.17.7.5 durften alle Konten im ganzen Familienordner lesen und schreiben (rekursiv,
  # auch als Vorgabe). Diese Rechte entfernen und lose Einträge nach gemeinsam/ verschieben
  # (ohne zu überschreiben), damit die neuen Arbeitsbereiche privat sind.
  local k e n=0
  while read -r k _; do
    [ -n "$k" ] && ! ist_admin "$k" && setfacl -R -x "u:$k" -x "d:u:$k" "$FAM" 2>/dev/null
  done < "$KARTE"
  for e in "$FAM"/* "$FAM"/.[!.]*; do
    [ -e "$e" ] || [ -L "$e" ] || continue
    case "$(basename "$e")" in gemeinsam|.struktur) continue ;; esac
    if [ -e "$FAM/gemeinsam/$(basename "$e")" ]; then
      log "WARNUNG: $e nicht verschoben, $FAM/gemeinsam/$(basename "$e") gibt es schon"
    else
      mv -n "$e" "$FAM/gemeinsam/" && n=$((n + 1))
    fi
  done
  (umask 077; date -Iseconds > "$FAM/.struktur")
  log "Familienordner auf Arbeitsbereiche umgestellt: $n Einträge nach $FAM/gemeinsam verschoben"
}

arbeitsbereich() { # $1 Konto: $FAM/<konto> mit dokumente, inbox, work; nur Konto, user, Administratoren
  local k=$1 b="$FAM/$1" p=rwX a
  mkdir -p "$b/dokumente" "$b/inbox" "$b/work"
  chown root:root "$b"; chmod 0770 "$b"
  setfacl -b "$b" 2>/dev/null      # oberste Ebene: alte oder geerbte Einträge anderer Konten weg
  [ -e "$b/$VOLL" ] && p=r-X
  setfacl -R -m "u:$k:$p" -m "d:u:$k:$p" -m u:user:rwX -m d:u:user:rwX "$b" 2>/dev/null
  for a in $ADMINS; do
    setfacl -R -m "u:$a:rwX" -m "d:u:$a:rwX" "$b" 2>/dev/null
  done
}

verlinken() { # $1 Konto, $2 Home: gleiche Struktur wie /share für Skills (~/dokumente, ~/inbox …)
  local k=$1 h=$2 n z
  for n in dokumente inbox work gemeinsam familie; do
    case "$n" in gemeinsam|familie) z="$FAM/gemeinsam" ;; *) z="$FAM/$k/$n" ;; esac
    if [ -L "$h/$n" ] || [ ! -e "$h/$n" ]; then
      ln -sfn "$z" "$h/$n"; chown -h "$k:$k" "$h/$n" 2>/dev/null
    fi
  done
}

speicher() { # Größe von Home und Arbeitsbereich je Konto, über QUOTA_GB schreibgeschützt
  [ "$QUOTA_GB" -gt 0 ] && [ -n "$FAM" ] || return 0
  local k b groesse grenze=$((QUOTA_GB * 1024 * 1024 * 1024))
  while read -r k _; do
    [ -n "$k" ] && ! ist_admin "$k" && [ -d "$FAM/$k" ] || continue
    b="$FAM/$k"
    groesse=$(du -sxb "$(home_von "$k")" "$b" 2>/dev/null | awk '{s += $1} END {print s + 0}')
    if [ "$groesse" -gt "$grenze" ] && [ ! -e "$b/$VOLL" ]; then
      awk -v g="$groesse" -v q="$QUOTA_GB" 'BEGIN { printf "Speicher voll: %.1f GB von %s GB belegt. Dateien mit dem Datei-Werkzeug löschen (die Shell darf im Arbeitsbereich dann nur lesen), danach geht es innerhalb einer Minute wieder.\n", g / 1073741824, q }' > "$b/$VOLL"
      chmod 644 "$b/$VOLL"
      setfacl -R -m "u:$k:r-X" -m "d:u:$k:r-X" "$b" 2>/dev/null
      log "$k: Speicher voll ($((groesse / 1024 / 1024)) MB > $QUOTA_GB GB), Arbeitsbereich schreibgeschützt"
    elif [ "$groesse" -le "$grenze" ] && [ -e "$b/$VOLL" ]; then
      rm -f "$b/$VOLL"
      setfacl -R -m "u:$k:rwX" -m "d:u:$k:rwX" "$b" 2>/dev/null
      log "$k: Speicher wieder frei ($((groesse / 1024 / 1024)) MB), Arbeitsbereich beschreibbar"
    fi
  done < "$KARTE"
}

sperren() { # $1 Konto: alle Einträge direkt unter /share außer dem Familienordner
  local k=$1 e
  for e in "$SHARE"/* "$SHARE"/.[!.]*; do
    [ -e "$e" ] || continue
    [ -n "$FAMILIE" ] && [ "$e" = "$SHARE/$FAMILIE" ] && continue
    getfacl -cp "$e" 2>/dev/null | grep -q "^user:$k:---" || setfacl -m "u:$k:---" "$e" 2>/dev/null
  done
}

anlegen() { # $1 Konto, $2 UID, $3 GID
  local k=$1 uid=$2 gid=${3:-$2} h
  h=$(home_von "$k")
  if ! getent passwd "$k" >/dev/null; then
    getent group "$gid" >/dev/null || groupadd -g "$gid" "$k"
    useradd -M -u "$uid" -g "$gid" -s /bin/bash -d "$h" "$k" || { log "WARNUNG: $k ($uid) nicht angelegt"; return; }
  fi
  rechte "$k"
}

start() {
  mkdir -p "$HOMES"; chmod 755 "$HOMES"; touch "$KARTE"; chmod 600 "$KARTE"
  [ -n "$FAM" ] && mkdir -p "$FAM"
  familie_vorbereiten
  # Administratoren vorab anlegen, damit Open Terminal ihr Home /data/home nimmt
  local a uid
  for a in $ADMINS; do
    if ! grep -q "^$a " "$KARTE"; then
      uid=$( { awk -F: '$3>=20000 && $3<60000 {print $3}' /etc/passwd /etc/group; tr ' ' '\n' < "$KARTE" | grep -E '^[0-9]+$'; } | sort -n | tail -1)
      uid=$(( ${uid:-19999} + 1 ))
      echo "$a $uid $uid" >> "$KARTE"
    fi
  done
  while read -r k uid gid; do
    [ -n "$k" ] && anlegen "$k" "$uid" "$gid"
  done < "$KARTE"
}

waechter() {
  local n=0 k uid
  while sleep 3; do
    while IFS=: read -r k _ uid gid _; do
      grep -q "^$k " "$KARTE" && continue
      echo "$k $uid $gid" >> "$KARTE"
      log "neues Konto $k (UID $uid)"
      rechte "$k"
    done < <(awk -F: '$3>=20000 && $3<60000' /etc/passwd)
    n=$((n + 1))
    if [ $((n % 20)) -eq 0 ]; then   # neue Einträge unter /share auch sperren (etwa jede Minute)
      while read -r k _; do [ -n "$k" ] && ! ist_admin "$k" && sperren "$k"; done < "$KARTE"
      speicher
    fi
  done
}

aufraeumen() {
  [ -f "$KARTE" ] || return 0
  local k e
  while read -r k _; do
    [ -n "$k" ] || continue
    for e in "$SHARE" "$SHARE"/* "$SHARE"/.[!.]* "$DATA" "$DATA/home" "$OPTS" "$DATA/api_key"; do
      [ -e "$e" ] && setfacl -x "u:$k" "$e" 2>/dev/null
    done
    for e in "$DATA/home" ${FAMILIE:+"$SHARE/$FAMILIE"} $(cat "$ZIELE" 2>/dev/null); do
      [ -e "$e" ] && setfacl -R -x "u:$k" -x "d:u:$k" "$e" 2>/dev/null
    done
  done < "$KARTE"
  log "Rechte der Mehrbenutzer-Konten entfernt (Homes unter $HOMES bleiben)"
}

webdav() {
  # Zugangsdaten in /data/webdav/rclone.conf: root 0600, Leserecht per ACL nur für die Konten
  # der Administratoren. "user" (der Server von Open Terminal, liest Dateien für alle Nutzer)
  # und alle anderen Konten kommen nicht hinein. Im Home der Administratoren nur ein Link.
  local wd="$DATA/webdav" conf="$DATA/webdav/rclone.conf" link="$DATA/home/.config/rclone/rclone.conf"
  local url name user pass vendor obs a
  url=$(jq -r '.webdav.url // ""' "$OPTS" 2>/dev/null)
  aus() {
    rm -rf "$wd"
    [ -L "$link" ] && [ "$(readlink "$link")" = "$conf" ] && rm -f "$link"
    return 0
  }
  [ -n "$url" ] || { aus; return 0; }
  if [ "$(jq -r '.multi_user // false' "$OPTS")" != "true" ] || [ -z "${ADMINS// /}" ]; then
    log "WARNUNG: WebDAV nicht eingerichtet – nur im Mehrbenutzer-Modus mit Administratoren (admin_users), sonst könnten alle Nutzer die Zugangsdaten lesen"
    aus; return 0
  fi
  command -v rclone >/dev/null || { log "WARNUNG: rclone fehlt, WebDAV nicht eingerichtet"; aus; return 0; }
  name=$(jq -r '.webdav.name // "webdav"' "$OPTS"); name=${name:-webdav}
  user=$(jq -r '.webdav.user // "" | gsub("[\\r\\n]"; "")' "$OPTS")
  pass=$(jq -r '.webdav.password // ""' "$OPTS")
  vendor=$(jq -r '.webdav.vendor // "other"' "$OPTS")
  case "$url" in http://*) log "WARNUNG: WebDAV ohne https – Passwort geht unverschlüsselt übers Netz" ;; esac
  # Passwort nur über stdin an rclone (nicht in der Prozessliste sichtbar)
  obs=""
  if [ -n "$pass" ]; then
    obs=$(printf '%s' "$pass" | rclone obscure - 2>/dev/null) || { log "WARNUNG: rclone obscure fehlgeschlagen, WebDAV nicht eingerichtet"; aus; return 0; }
  fi
  unset pass
  rm -rf "$wd"
  (umask 077; mkdir -p "$wd"
   { printf '[%s]\ntype = webdav\nurl = %s\nvendor = %s\n' "$name" "$url" "$vendor"
     [ -n "$user" ] && printf 'user = %s\n' "$user"
     [ -n "$obs" ] && printf 'pass = %s\n' "$obs"
   } > "$conf")
  chown -R root:root "$wd"; chmod 700 "$wd"; chmod 600 "$conf"
  for a in $ADMINS; do
    setfacl -m "u:$a:--x" "$wd" && setfacl -m "u:$a:r--" "$conf" \
      || log "WARNUNG: Leserecht für $a auf die WebDAV-Zugangsdaten nicht gesetzt"
  done
  mkdir -p "$(dirname "$link")"; chown user:user "$DATA/home/.config" "$(dirname "$link")" 2>/dev/null
  if [ -e "$link" ] && [ ! -L "$link" ]; then
    log "WARNUNG: $link ist eine eigene Datei, nicht ersetzt – rclone dort mit --config $conf aufrufen"
  else
    ln -sfn "$conf" "$link"; chown -h user:user "$link"
  fi
  log "WebDAV: Ziel $name: ($(sed -E 's#^(https?://)([^/@]*@)?([^/]+).*#\1\3#' <<<"$url")) für Administratoren eingerichtet"
}

case "${1:-}" in
  start) start ;;
  waechter) waechter ;;
  aufraeumen) aufraeumen ;;
  webdav) webdav ;;
  *) echo "Aufruf: terminal-konten start|waechter|aufraeumen|webdav" >&2; exit 2 ;;
esac
